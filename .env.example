# Copy to .env and fill in. Never commit .env or the certificates.
MQTT_HOST=your-broker.example.com
MQTT_PORT=8883
MQTT_TOPIC=test/topic
# MQTT_CLIENT_ID=my-device        # default: random; AWS IoT may require it to match the thing name/policy
MQTT_KEY=./certs/client.key
MQTT_CERT=./certs/client.crt
MQTT_CA=./certs/ca.pem
# MQTT_INSECURE=true              # skip broker certificate check (self-signed tests only)
